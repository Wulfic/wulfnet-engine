#version 450

// =============================================================================
// WulfNet Engine - IFS Iterated (Deterministic) Expansion
// =============================================================================
// Each thread reads a parent particle and writes transformCount children
// by applying each affine transform deterministically.
// =============================================================================

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer ParticleBuffer {
    vec4 particles[];
};

layout(std430, binding = 1) readonly buffer TransformBuffer {
    mat4 transforms[];
};

layout(push_constant) uniform PushConstants {
    uint transformCount;
    uint generationOffset;
    uint generationLimit;
};

void main() {
    uint threadID = gl_GlobalInvocationID.x + generationOffset;

    if (threadID < generationLimit) {
        // Read the parent particle
        uint parentIndex = (threadID - 1u) / transformCount;
        vec3 seedPos = particles[parentIndex].xyz;

        // Apply the transform for this thread's index
        mat4 attractor = transforms[threadID % transformCount];
        vec4 newPosition = attractor * vec4(seedPos, 1.0);

        particles[threadID] = vec4(newPosition.xyz, 0.0);
    }
}
