// =============================================================================
// WulfNet Engine - SWE Boundary Compute Shader
// =============================================================================
// Reflective boundary conditions: zero velocities at edges,
// copy waterHeight from interior neighbours to prevent leakage.
// Also clamps any negative water heights.
//
// Compile: glslc -fshader-stage=compute swe_boundary.comp -o swe_boundary.spv
// =============================================================================

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// WaterCell: .x=waterHeight, .y=terrainHeight, .z=vx, .w=vz
layout(std430, binding = 0) buffer GridBuffer { vec4 grid[]; };

layout(push_constant) uniform SWEParams {
    uint  gridSizeX;
    uint  gridSizeZ;
    float gravity_over_cs;
    float damping;
    float viscosity;
    float dt;
    float _pad0;
    float _pad1;
} params;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint z = gl_GlobalInvocationID.y;

    if (x >= params.gridSizeX || z >= params.gridSizeZ)
        return;

    uint idx = z * params.gridSizeX + x;

    // Clamp negative water everywhere
    if (grid[idx].x < 0.0)
        grid[idx].x = 0.0;

    // Now handle boundary edges — reflective
    bool isEdge = (x == 0 || x == params.gridSizeX - 1 ||
                   z == 0 || z == params.gridSizeZ - 1);

    if (!isEdge)
        return;

    // Zero out velocities at boundary
    grid[idx].z = 0.0;
    grid[idx].w = 0.0;

    // Reflective: copy water height from nearest interior neighbour
    uint interiorIdx = idx;

    if (x == 0)
        interiorIdx = idx + 1;
    else if (x == params.gridSizeX - 1)
        interiorIdx = idx - 1;
    
    if (z == 0)
        interiorIdx = (z + 1) * params.gridSizeX + x;
    else if (z == params.gridSizeZ - 1)
        interiorIdx = (z - 1) * params.gridSizeX + x;

    // Copy terrain stays the same, just replicate water level
    grid[idx].x = grid[interiorIdx].x;
}
