#version 450
// WulfNet Engine V3 Water System
// Shallow Water Equations - Vulkan Compute Shader Backend

layout (local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform WaterConfig {
    float gridSize;
    float dt;
    float gravity;
    float pipeCrossArea;
    uint width;
    uint height;
} config;

layout(std430, binding = 1) buffer TerrainHeight { float terrainHeight[]; };
layout(std430, binding = 2) buffer WaterDepth    { float waterDepth[]; };
// Vectorized 128-bit aligned buffer for optimized Nvidia Warp cache mapping
layout(std430, binding = 3) buffer FluxMap       { vec4 fluxMap[]; };

// LDS - Group Shared Memory for 8x8 + halo
shared float shared_H[10][10];

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;

    uint idx = y * config.width + x;

    // Load Center
    float H_self = 0.0f;
    if (x < config.width && y < config.height) {
        H_self = terrainHeight[idx] + waterDepth[idx];
        shared_H[ly + 1][lx + 1] = H_self;
    }

    // Load Halos
    if (lx == 0 && x > 0) 
        shared_H[ly + 1][0] = terrainHeight[idx - 1] + waterDepth[idx - 1];
    if (lx == 7 && x < config.width - 1) 
        shared_H[ly + 1][9] = terrainHeight[idx + 1] + waterDepth[idx + 1];
    if (ly == 0 && y > 0) 
        shared_H[0][lx + 1] = terrainHeight[idx - config.width] + waterDepth[idx - config.width];
    if (ly == 7 && y < config.height - 1) 
        shared_H[9][lx + 1] = terrainHeight[idx + config.width] + waterDepth[idx + config.width];

    barrier(); // Enforce LDS sync across subgroup!

    if (x >= config.width || y >= config.height) return;

    float H_L = (x > 0) ? shared_H[ly + 1][lx] : H_self;
    float H_R = (x < config.width - 1) ? shared_H[ly + 1][lx + 2] : H_self;
    float H_T = (y > 0) ? shared_H[ly][lx + 1] : H_self;
    float H_B = (y < config.height - 1) ? shared_H[ly + 2][lx + 1] : H_self;

    float C = config.dt * config.gravity * config.pipeCrossArea / config.gridSize;
    vec4 currentFlux = fluxMap[idx];

    // Outward flux equations using shared memory
    float fL = max(0.0f, currentFlux.x + C * (H_self - H_L));
    float fR = max(0.0f, currentFlux.y + C * (H_self - H_R));
    float fT = max(0.0f, currentFlux.z + C * (H_self - H_T));
    float fB = max(0.0f, currentFlux.w + C * (H_self - H_B));

    // Boundary rules
    if (x == 0) fL = 0.0f;
    if (x == config.width - 1) fR = 0.0f;
    if (y == 0) fT = 0.0f;
    if (y == config.height - 1) fB = 0.0f;

    // Conservation metric K
    float totalFlux = fL + fR + fT + fB;
    if (totalFlux > 0.0f) {
        float K = min(1.0f, (waterDepth[idx] * config.gridSize * config.gridSize) / (config.dt * totalFlux));
        fL *= K; fR *= K; fT *= K; fB *= K;
    }

    fluxMap[idx] = vec4(fL, fR, fT, fB);
}