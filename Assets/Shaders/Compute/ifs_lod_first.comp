#version 450

// =============================================================================
// WulfNet Engine - IFS LOD First Iteration
// =============================================================================
// Seeds the LOD prediction by applying each transform to the origin.
// =============================================================================

layout(local_size_x = 1) in;

layout(std430, binding = 0) writeonly buffer OutputBuffer {
    vec4 outputData[];
};

layout(std430, binding = 1) readonly buffer TransformBuffer {
    mat4 transforms[];
};

layout(push_constant) uniform PushConstants {
    int transformCount;
};

void main() {
    for (int i = 0; i < transformCount; ++i) {
        outputData[gl_GlobalInvocationID.x + i] = transforms[i] * vec4(0.0, 0.0, 0.0, 1.0);
    }
}
